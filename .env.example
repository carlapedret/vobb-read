# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit your real key.

# --- Goodreads ---
# Your shelf's private RSS feed URL, e.g.:
#   https://www.goodreads.com/review/list_rss/<your_user_id>?key=<your_key>&shelf=to-read
# Find it on Goodreads: My Books -> a shelf -> "RSS" link at the bottom of the shelf page.
GOODREADS_RSS_URL=

# --- VOEBB ---
# Base URL of the live aDIS/BMS search form. Do not point this at a bookmarked
# results page -- it must be the plain search-form URL; the app always starts
# a fresh session from here.
VOEBB_BASE_URL=https://www.voebb.de/aDISWeb/app/prod00

# Seconds to sleep between successive VOEBB searches (min, max). Keep this
# polite -- this tool is for checking your own reading list, not scraping.
VOEBB_DELAY_MIN=2
VOEBB_DELAY_MAX=5
